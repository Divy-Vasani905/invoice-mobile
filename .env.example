# Public client environment variables (inlined into the JS bundle).
# Never put private secrets here — anything with EXPO_PUBLIC_ is visible in the app binary.
# Docs: https://docs.expo.dev/guides/environment-variables/

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Firebase (React Native Firebase uses google-services files for native init.
# These public values are optional helpers for JS-side config / debugging.)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Google AdMob
# App IDs are read by app.config.ts for the react-native-google-mobile-ads plugin
# (native AndroidManifest / Info.plist). Expo loads this file when evaluating
# app.config.ts during prebuild / run:android / EAS Build.
#
# Unit IDs:
# - Development (__DEV__): the app ALWAYS uses Google sample Interstitial/Rewarded
#   unit IDs from react-native-google-mobile-ads TestIds (never these env values).
# - Production release builds: use the real unit IDs you set below.
#
# Do NOT commit real production unit IDs to this example file.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=

# -----------------------------------------------------------------------------
# RevenueCat (public SDK keys — not secret server keys)
# -----------------------------------------------------------------------------
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Optional: EAS project id (if using EAS Build)
EXPO_PUBLIC_EAS_PROJECT_ID=
